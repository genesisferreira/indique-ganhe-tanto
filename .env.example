# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron — rotas /api/cron/*
# Gere uma chave forte: openssl rand -base64 32
# Header: Authorization: Bearer {CRON_SECRET}
CRON_SECRET=

# BRByte — sincronização automática (/api/cron/brbyte-sync)
# Manter false até endpoint oficial de cobrança; infra não marca pagamento automático
BRBYTE_SYNC_ENABLED=false
BRBYTE_API_URL=
BRBYTE_API_KEY=
BRBYTE_SYNC_TIMEOUT_MS=30000

# Data Provider
# mock     -> usa repositórios mock (estado atual recomendado)
# supabase -> usa repositórios Supabase (somente quando estiverem implementados)
DATA_PROVIDER=mock

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Indique e Ganhe - Tanto Telecom

# Optional: Analytics
# NEXT_PUBLIC_ANALYTICS_ID=
