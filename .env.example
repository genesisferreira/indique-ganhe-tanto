# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron — rotas /api/cron/*
# Gere uma chave forte: openssl rand -base64 32
# Header: Authorization: Bearer {CRON_SECRET}
CRON_SECRET=

# BRByte — sincronização automática (/api/cron/brbyte-sync)
# Manter false até endpoint oficial de cobrança; infra não marca pagamento automático
BRBYTE_SYNC_ENABLED=false
BRBYTE_AUTO_MARK_PAID_ENABLED=false
BRBYTE_CREATE_INTEREST_ENABLED=false
BRBYTE_AUTO_CREATE_INTEREST_ON_REFERRAL=false
BRBYTE_AUTO_CHECK_CONVERSION=false
BRBYTE_AUTO_CHECK_FIRST_INVOICE=false
BRBYTE_API_URL=
BRBYTE_API_KEY=
BRBYTE_API_USER=
BRBYTE_API_PASSWORD=
BRBYTE_DEFAULT_LEAD_PK=
BRBYTE_DEFAULT_INTEREST_STATUS=
BRBYTE_DEFAULT_PLAN_PK=
BRBYTE_SYNC_TIMEOUT_MS=30000
BRBYTE_SYNC_BATCH_SIZE=20
BRBYTE_SYNC_MAX_ATTEMPTS=5
BRBYTE_SYNC_RETRY_MINUTES=60

# Pré-cadastro público (/pre-cadastro) — captação direta sem indicador/recompensa
PUBLIC_PRE_REGISTRATION_ENABLED=false
PUBLIC_PRE_REGISTRATION_TURNSTILE_ENABLED=false
PUBLIC_PRE_REGISTRATION_RATE_LIMIT_MAX=5
PUBLIC_PRE_REGISTRATION_RATE_LIMIT_WINDOW_MINUTES=15
PUBLIC_PRE_REGISTRATION_DEDUP_MINUTES=15
# Opcional: IDs fixos dos planos no CRM (API /plans legado)
PUBLIC_PRE_REGISTRATION_PLAN_500_ID=
PUBLIC_PRE_REGISTRATION_PLAN_1000_ID=
# UUID técnico para referrals.plan_id (FK). Oferta comercial fica em public_offer_*.
PUBLIC_PRE_REGISTRATION_BASE_CRM_PLAN_ID=
# plan_pk base do Controllr para pré-cadastro (não expor no client)
PUBLIC_PRE_REGISTRATION_DEFAULT_BRBYTE_PLAN_PK=

# Data Provider
# mock     -> usa repositórios mock (estado atual recomendado)
# supabase -> usa repositórios Supabase (somente quando estiverem implementados)
DATA_PROVIDER=mock

# Demo login page (NEXT_PUBLIC_* are exposed to the browser)
# Keep false in production unless you explicitly want demo shortcuts on /login
NEXT_PUBLIC_ENABLE_DEMO_LINKS=false

# Optional: demo accounts when NEXT_PUBLIC_ENABLE_DEMO_LINKS=true
# NEXT_PUBLIC_DEMO_INDICADOR_EMAIL=
# NEXT_PUBLIC_DEMO_INDICADOR_PASSWORD=
# NEXT_PUBLIC_DEMO_COMERCIAL_EMAIL=
# NEXT_PUBLIC_DEMO_COMERCIAL_PASSWORD=
# NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
# NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Indique e Ganhe - Tanto Telecom

# Optional: Analytics
# NEXT_PUBLIC_ANALYTICS_ID=
